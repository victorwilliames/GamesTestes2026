{
  "name": "arena-no-rest",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm.cmd install && npm.cmd install --prefix client && npm.cmd install --prefix server",
    "dev:client": "npm.cmd run dev --prefix client",
    "dev:server": "npm.cmd run dev --prefix server",
    "build:client": "npm.cmd run build --prefix client",
    "build:server": "npm.cmd run build --prefix server",
    "start:server": "npm.cmd run start --prefix server",
    "dev": "concurrently \"npm.cmd run dev:client\" \"npm.cmd run dev:server\""
  },
  "dependencies": {},
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
